{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/protocol/v0/live-lease.schema.json",
  "title": "Decoded Live control lease claims v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss", "aud", "sub", "jti", "performance_id", "show_revision_id",
    "authority_epoch", "node_boot_id", "client_session_id", "cnf",
    "commands", "iat", "nbf", "exp", "max_boot_age_s", "limits"
  ],
  "properties": {
    "iss": {"type": "string", "minLength": 1, "maxLength": 128},
    "aud": {"type": "string", "minLength": 1, "maxLength": 128},
    "sub": {"type": "string", "minLength": 1, "maxLength": 128},
    "jti": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22,64}$"},
    "performance_id": {"type": "string", "format": "uuid"},
    "show_revision_id": {"type": "string", "format": "uuid"},
    "authority_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "node_boot_id": {"type": "string", "format": "uuid"},
    "client_session_id": {"type": "string", "format": "uuid"},
    "cnf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jkt"],
      "properties": {"jkt": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "AdvanceCue", "BackCue", "SkipCue", "HoldCue", "ResumeCue",
          "BeginCueRebase", "CommitCueRebase", "TransferCueAuthority",
          "PrepareAssignmentPlan", "CommitAssignmentIntent",
          "BeginPhysicalChange", "RecordInstalledBoundary",
          "RecordVerification", "RecordA1Receipt", "FailChange",
          "AbandonChange", "RevertAssignment", "PromoteFallback",
          "StartMicCheck", "AdvanceMicCheck", "RecordCheckDimension",
          "CloseMicCheck"
        ]
      }
    },
    "iat": {"type": "integer", "minimum": 0, "maximum": 4102444800},
    "nbf": {"type": "integer", "minimum": 0, "maximum": 4102444800},
    "exp": {"type": "integer", "minimum": 0, "maximum": 4102444800},
    "max_boot_age_s": {"type": "integer", "minimum": 1, "maximum": 86400},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_message_bytes", "commands_per_minute", "offline_canonical_commands"],
      "properties": {
        "max_message_bytes": {"type": "integer", "minimum": 1024, "maximum": 262144},
        "commands_per_minute": {"type": "integer", "minimum": 1, "maximum": 600},
        "offline_canonical_commands": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/protocol/v0/result-query.schema.json",
  "title": "Idempotency result query v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "message_type", "lease_id", "authority_epoch", "idempotency_namespace", "idempotency_key", "correlation_id"],
  "properties": {
    "protocol": {"const": "runtime-control.v0"},
    "message_type": {"const": "result-query"},
    "lease_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22,64}$"},
    "authority_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "idempotency_namespace": {"type": "string", "minLength": 1, "maxLength": 256},
    "idempotency_key": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"}
  }
}

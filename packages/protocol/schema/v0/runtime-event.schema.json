{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/protocol/v0/runtime-event.schema.json",
  "title": "Canonical runtime event envelope v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "message_type", "event_id", "event_type", "schema_id", "stream_id", "stream_sequence", "global_position", "aggregates", "transaction_id", "command_id", "correlation_id", "causation_id", "actor_id", "effective_boundary", "recorded_utc", "prior_state", "current_state", "payload", "payload_hash", "previous_event_hash"],
  "properties": {
    "protocol": {"const": "runtime-event.v0"},
    "message_type": {"const": "canonical-event"},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["PerformanceTransitioned", "AssignmentIntentCommitted", "PhysicalChangeBegun", "ComponentDisconnected", "ComponentInstalled", "SignalPathStateObserved", "VerificationRecorded", "A1ReceiptRecorded", "CueAuthorityChanged", "CueOccurrenceCreated", "MicCheckStateChanged", "TakeoverFenceChanged"]},
    "schema_id": {"type": "string", "pattern": "^[a-z0-9.-]+/v[0-9]+$", "maxLength": 96},
    "stream_id": {"type": "string", "format": "uuid"},
    "stream_sequence": {"type": "string", "format": "u64-string"},
    "global_position": {"type": "object", "additionalProperties": false, "required": ["authority_epoch", "authority_sequence"], "properties": {"authority_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "authority_sequence": {"type": "string", "format": "u64-string"}}},
    "aggregates": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["type", "id", "revision"], "properties": {"type": {"enum": ["Activation", "Performance", "CueRuntime", "PerformanceOverlay", "PhysicalAssignment", "MicCheckSession"]}, "id": {"type": "string", "format": "uuid"}, "revision": {"type": "string", "format": "u64-string"}}}},
    "transaction_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"oneOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "effective_boundary": {"$ref": "https://local.audio.invalid/protocol/v0/common.schema.json#/$defs/effectiveBoundary"},
    "recorded_utc": {"type": "string", "format": "utc-date-time"},
    "prior_state": {"oneOf": [{"type": "object", "maxProperties": 128}, {"type": "null"}]},
    "current_state": {"type": "object", "maxProperties": 128},
    "payload": {"type": "object", "maxProperties": 128},
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

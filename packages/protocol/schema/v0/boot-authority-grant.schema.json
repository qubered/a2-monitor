{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/protocol/v0/boot-authority-grant.schema.json",
  "title": "Boot-scoped authority grant v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["signed", "signature"],
  "properties": {
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "node_id", "node_boot_id", "authority_epoch", "performance_id", "show_revision_id", "issued_utc", "monotonic_valid_for_ms"],
      "properties": {
        "grant_id": {"type": "string", "format": "uuid"},
        "node_id": {"type": "string", "format": "uuid"},
        "node_boot_id": {"type": "string", "format": "uuid"},
        "authority_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "performance_id": {"type": "string", "format": "uuid"},
        "show_revision_id": {"type": "string", "format": "uuid"},
        "issued_utc": {"type": "string", "format": "utc-date-time"},
        "monotonic_valid_for_ms": {"type": "integer", "minimum": 1000, "maximum": 86400000}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "kid", "value"],
      "properties": {
        "alg": {"const": "ES256"},
        "kid": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
      }
    }
  }
}

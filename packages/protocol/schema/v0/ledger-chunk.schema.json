{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/protocol/v0/ledger-chunk.schema.json",
  "title": "Sealed canonical ledger chunk v0",
  "type": "object", "additionalProperties": false,
  "required": ["header", "events", "signature"],
  "properties": {
    "header": {
      "type": "object", "additionalProperties": false,
      "required": ["chunk_id", "node_id", "node_boot_id", "authority_epoch", "performance_id", "first_sequence", "last_sequence", "prior_chunk_hash", "event_merkle_root", "schema_ids", "created_utc", "byte_count"],
      "properties": {
        "chunk_id": {"type": "string", "format": "uuid"}, "node_id": {"type": "string", "format": "uuid"}, "node_boot_id": {"type": "string", "format": "uuid"},
        "authority_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "performance_id": {"type": "string", "format": "uuid"},
        "first_sequence": {"type": "string", "format": "u64-string"}, "last_sequence": {"type": "string", "format": "u64-string"},
        "prior_chunk_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "created_utc": {"type": "string", "format": "utc-date-time"}, "byte_count": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    },
    "events": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"type": "object"}},
    "signature": {"$ref": "https://local.audio.invalid/protocol/v0/runtime-command.schema.json#/$defs/signature"}
  }
}

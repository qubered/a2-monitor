{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/protocol/v0/runtime-result.schema.json",
  "title": "Canonical runtime result and acknowledgement v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "message_type", "command_id", "idempotency_key", "channel_id", "channel_counter", "authority_epoch", "status", "result", "result_hash", "previous_ack_hash", "ack_hash", "committed_utc"],
  "properties": {
    "protocol": {"const": "runtime-control.v0"},
    "message_type": {"const": "command-result"},
    "command_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "format": "uuid"},
    "channel_id": {"type": "string", "format": "uuid"},
    "channel_counter": {"type": "string", "format": "u64-string"},
    "authority_epoch": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "status": {"enum": ["committed", "rejected"]},
    "result": {"type": "object", "maxProperties": 128},
    "error": {"$ref": "https://local.audio.invalid/protocol/v0/common.schema.json#/$defs/error"},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_ack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "committed_utc": {"type": "string", "format": "utc-date-time"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "rejected"}}}, "then": {"properties": {"error": {}}, "required": ["error"]}},
    {"if": {"properties": {"status": {"const": "committed"}}}, "then": {"not": {"required": ["error"]}}}
  ]
}

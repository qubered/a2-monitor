{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/protocol/v0/common.schema.json",
  "title": "Protocol v0 common types",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "format": "u64-string",
      "description": "Canonical decimal unsigned 64-bit value; the required format validator enforces <= 18446744073709551615."
    },
    "authorityEpoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "utc-date-time",
      "maxLength": 35
    },
    "aggregateRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "expected_revision"],
      "properties": {
        "type": {"enum": ["Activation", "Performance", "CueRuntime", "PerformanceOverlay", "PhysicalAssignment", "MicCheckSession"]},
        "id": {"$ref": "#/$defs/uuid"},
        "expected_revision": {"$ref": "#/$defs/u64"}
      }
    },
    "effectiveBoundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "capture_epoch", "capture_frame"],
          "properties": {
            "kind": {"const": "capture-frame"},
            "capture_epoch": {"$ref": "#/$defs/uuid"},
            "capture_frame": {"$ref": "#/$defs/u64"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timebase_boot_id", "monotonic_ns", "utc", "uncertainty_ms"],
          "properties": {
            "kind": {"const": "mapped-time"},
            "timebase_boot_id": {"$ref": "#/$defs/uuid"},
            "monotonic_ns": {"$ref": "#/$defs/u64"},
            "utc": {"$ref": "#/$defs/dateTime"},
            "uncertainty_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT", "UNAUTHORIZED", "FORBIDDEN",
            "STALE_REVISION", "STALE_AUTHORITY", "LEASE_EXPIRED",
            "LEASE_BOOT_MISMATCH", "REPLAY_DETECTED",
            "IDEMPOTENCY_CONFLICT", "PREPARE_EXPIRED",
            "PHYSICAL_STATE_CONFLICT", "CAPACITY_FLOOR",
            "DEPENDENCY_STALE", "UNSUPPORTED_SCHEMA", "OUTCOME_UNKNOWN",
            "TAKEOVER_FENCE_REQUIRED"
          ]
        },
        "message": {"type": "string", "maxLength": 1024},
        "current_revision": {"$ref": "#/$defs/u64"},
        "correlation_id": {"$ref": "#/$defs/uuid"}
      }
    }
  }
}

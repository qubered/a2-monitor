{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/protocol/v0/prune-permit.schema.json",
  "title": "Exact ledger prune permit v0", "type": "object", "additionalProperties": false,
  "required": ["signed", "signature"],
  "properties": {
    "signed": {"type": "object", "additionalProperties": false, "required": ["permit_id", "node_id", "chunk_hash", "first_sequence", "last_sequence", "backup_generation", "expires_utc"], "properties": {
      "permit_id": {"type": "string", "format": "uuid"}, "node_id": {"type": "string", "format": "uuid"}, "chunk_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "first_sequence": {"type": "string", "format": "u64-string"}, "last_sequence": {"type": "string", "format": "u64-string"}, "backup_generation": {"type": "string", "minLength": 1, "maxLength": 128}, "expires_utc": {"type": "string", "format": "utc-date-time"}
    }},
    "signature": {"$ref": "https://local.audio.invalid/protocol/v0/runtime-command.schema.json#/$defs/signature"}
  }
}

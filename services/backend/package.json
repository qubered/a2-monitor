{
  "name": "@a2-monitor/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format && npm run lint && npm run test && npm run build",
    "dev": "npm run build && node --watch dist/start.js",
    "format": "prettier --check \"src/**/*.ts\" \"*.{json,ts}\"",
    "lint": "eslint .",
    "start": "node dist/start.js",
    "test": "vitest run src"
  },
  "dependencies": {
    "@a2-monitor/protocol": "0.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.2"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/evidence-waiver.schema.json",
  "title": "Signed evidence waiver",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "waiver_id", "test_id", "owner", "reason", "expires_utc", "prohibited_promotions", "signature"],
  "properties": {
    "schema_version": {"const": "evidence-waiver/v0"},
    "waiver_id": {"type": "string", "format": "uuid"},
    "test_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
    "expires_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "prohibited_promotions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["0A", "0B", "1A.1", "1A.2", "1A.3", "rehearsal", "beta"]}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["alg", "key_id", "value"], "properties": {"alg": {"const": "ES256"}, "key_id": {"type": "string", "minLength": 1}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}}
  }
}

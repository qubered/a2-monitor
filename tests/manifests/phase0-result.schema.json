{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/phase0-result.schema.json",
  "title": "Signed Phase 0 result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "input_manifest_sha256", "commit",
    "runner_id", "started_utc", "ended_utc", "outcome", "assertions",
    "artifacts", "deviations", "signature"
  ],
  "properties": {
    "schema_version": {"const": "phase0-result/v0"},
    "result_id": {"type": "string", "format": "uuid"},
    "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "started_utc": {"type": "string", "format": "date-time"},
    "ended_utc": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["pass", "fail", "invalid"]},
    "assertions": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric", "outcome", "observed", "unit"],
        "properties": {
          "metric": {"type": "string", "maxLength": 96},
          "outcome": {"enum": ["pass", "fail", "not-run"]},
          "observed": {"type": "number"},
          "unit": {"type": "string", "maxLength": 32},
          "notes": {"type": "string", "maxLength": 1024}
        }
      }
    },
    "artifacts": {
      "type": "array", "maxItems": 2048,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "sha256", "bytes", "store_key"],
        "properties": {
          "kind": {"type": "string", "maxLength": 64},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "store_key": {"type": "string", "maxLength": 512}
        }
      }
    },
    "deviations": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 1024}},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["alg", "key_id", "signed_jcs_sha256", "value"],
      "properties": {
        "alg": {"enum": ["Ed25519", "ES256"]},
        "key_id": {"type": "string", "maxLength": 256},
        "signed_jcs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 1024}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/evidence-result.schema.json",
  "title": "Signed evidence result; pass/fail is computed from hashed metric artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "manifest_id", "manifest_sha256", "test_id", "commit", "runner_id", "started_utc", "ended_utc", "assertions", "artifacts", "deviations", "waiver_ids", "signature"],
  "properties": {
    "schema_version": {"const": "evidence-result/v0"},
    "result_id": {"type": "string", "format": "uuid"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "started_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "ended_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "artifact_sha256"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_.]+$"}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "sha256", "bytes", "store_key"], "properties": {"kind": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1}, "store_key": {"type": "string", "minLength": 1, "maxLength": 512}}}},
    "deviations": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "waiver_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["alg", "key_id", "value"], "properties": {"alg": {"const": "ES256"}, "key_id": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}}
  }
}

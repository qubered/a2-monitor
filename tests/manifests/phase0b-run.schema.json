{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/phase0b-run.schema.json",
  "title": "Frozen Phase 0B run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "test_id", "commit", "tuple", "clients", "network", "limits", "trials", "faults", "assertion_ids", "artifact_kinds"],
  "properties": {
    "schema_version": {"const": "phase0b-run/v0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "test_id": {"enum": ["media.wired.impairment.v1", "media.wifi.impairment.v1", "system.combined-soak.v1", "control.takeover-partition.v1", "cue.qlab-shadow.v1"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tuple": {"type": "object", "additionalProperties": false, "required": ["os", "os_version", "cpu", "ram_bytes", "storage", "filesystem"], "properties": {"os": {"enum": ["windows", "macos"]}, "os_version": {"type": "string", "minLength": 1}, "cpu": {"type": "string", "minLength": 1}, "ram_bytes": {"type": "integer", "minimum": 4294967296}, "storage": {"type": "string", "minLength": 1}, "filesystem": {"type": "string", "minLength": 1}}},
    "clients": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["class", "device", "os_version", "browser_version", "output_route"], "properties": {"class": {"enum": ["wired", "wifi6"]}, "device": {"type": "string", "minLength": 1}, "os_version": {"type": "string", "minLength": 1}, "browser_version": {"type": "string", "minLength": 1}, "output_route": {"type": "string", "minLength": 1}}}},
    "network": {"type": "object", "additionalProperties": false, "required": ["switch", "access_point", "client_subnet", "media_udp_range"], "properties": {"switch": {"type": "string", "minLength": 1}, "access_point": {"type": "string", "minLength": 1}, "client_subnet": {"type": "string", "minLength": 1}, "media_udp_range": {"type": "string", "pattern": "^[0-9]{1,5}-[0-9]{1,5}$"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["audio_clients", "replay_readers", "ledger_bytes", "replay_bytes", "worker_memory_bytes", "worker_handles", "worker_sockets", "fsync_p99_ms"], "properties": {"audio_clients": {"type": "integer", "minimum": 1, "maximum": 8}, "replay_readers": {"type": "integer", "minimum": 0, "maximum": 2}, "ledger_bytes": {"type": "integer", "minimum": 1048576}, "replay_bytes": {"type": "integer", "minimum": 1048576}, "worker_memory_bytes": {"type": "integer", "minimum": 1048576}, "worker_handles": {"type": "integer", "minimum": 16}, "worker_sockets": {"type": "integer", "minimum": 4}, "fsync_p99_ms": {"type": "integer", "minimum": 1, "maximum": 1000}}},
    "trials": {"type": "object", "additionalProperties": false, "required": ["count", "duration_s", "warmup_s"], "properties": {"count": {"type": "integer", "minimum": 1, "maximum": 100}, "duration_s": {"type": "integer", "minimum": 60, "maximum": 172800}, "warmup_s": {"type": "integer", "minimum": 0, "maximum": 3600}}},
    "faults": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["at_s", "kind", "duration_s"], "properties": {"at_s": {"type": "integer", "minimum": 0}, "kind": {"enum": ["packet-loss", "jitter", "backend-restart", "roam", "disk-pressure", "replay-seek-storm", "receiver-reconnect-storm", "hostile-image-decode", "backend-partition", "old-node-power-off", "old-node-restart", "lease-replay", "qlab-reconnect", "duplicate-event", "late-event", "audition-event", "panic-reset"]}, "duration_s": {"type": "integer", "minimum": 0, "maximum": 86400}}}},
    "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.]+$"}},
    "artifact_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
  }
}

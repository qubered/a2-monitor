{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/phase0b-run.schema.json",
  "title": "Frozen Phase 0B system run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "test_id", "commit", "implementation", "tuple", "capture", "media_profile", "clients", "network", "limits", "trials", "faults", "assertion_ids", "artifact_kinds"],
  "properties": {
    "schema_version": {"const": "phase0b-run/v0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "test_id": {"enum": [
      "media.wired.impairment.v1",
      "media.wifi.impairment.v1",
      "media.clock-worker-recovery.v1",
      "media.admission-limit.v1",
      "contracts.runtime-conformance.v1",
      "storage.powercut-restore.v1",
      "appliance.lifecycle-update.v1",
      "security.pki-lifecycle.v1",
      "system.combined-soak.v1",
      "control.takeover-partition.v1",
      "cue.qlab-shadow.v1"
    ]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation": {"$ref": "#/$defs/implementation"},
    "tuple": {"$ref": "#/$defs/tuple"},
    "capture": {"$ref": "#/$defs/capture"},
    "media_profile": {"$ref": "#/$defs/mediaProfile"},
    "clients": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"$ref": "#/$defs/client"}},
    "network": {"$ref": "#/$defs/network"},
    "limits": {"$ref": "#/$defs/limits"},
    "trials": {"$ref": "#/$defs/trials"},
    "faults": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/fault"}},
    "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.]+$"}},
    "artifact_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
  },
  "allOf": [
    {
      "if": {"type": "object", "properties": {"tuple": {"type": "object", "properties": {"os": {"const": "windows"}}, "required": ["os"]}}, "required": ["tuple"]},
      "then": {
        "type": "object",
        "properties": {
          "capture": {"type": "object", "properties": {"host_api": {"enum": ["asio", "wasapi"]}}},
          "implementation": {"type": "object", "properties": {"str0m_crypto_provider": {"enum": ["wincrypto", "aws-lc-rs-fallback"]}}}
        }
      }
    },
    {
      "if": {"type": "object", "properties": {"tuple": {"type": "object", "properties": {"os": {"const": "macos"}}, "required": ["os"]}}, "required": ["tuple"]},
      "then": {
        "type": "object",
        "properties": {
          "capture": {"type": "object", "properties": {"host_api": {"const": "coreaudio"}}},
          "implementation": {"type": "object", "properties": {"str0m_crypto_provider": {"enum": ["apple-crypto", "aws-lc-rs-fallback"]}}}
        }
      }
    }
  ],
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "rust_version", "str0m_version", "str0m_crypto_provider", "libopus_version", "node_version", "fastify_version", "sqlite_version", "contracts_sha256", "dependency_lock_sha256"],
      "properties": {
        "build_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "rust_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "str0m_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "str0m_crypto_provider": {"enum": ["apple-crypto", "wincrypto", "aws-lc-rs-fallback", "rust-crypto-test"]},
        "libopus_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "node_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "fastify_version": {"type": "string", "pattern": "^5\\.(12\\.([2-9]|[1-9][0-9]+)|1[3-9]\\.[0-9]+|[2-9][0-9]\\.[0-9]+|[1-9][0-9]{2,}\\.[0-9]+)$"},
        "sqlite_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "contracts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "cpu", "ram_bytes", "storage", "filesystem"],
      "properties": {
        "os": {"enum": ["windows", "macos"]},
        "os_version": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "ram_bytes": {"type": "integer", "minimum": 4294967296},
        "storage": {"type": "string", "minLength": 1},
        "filesystem": {"type": "string", "minLength": 1}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_api", "device_class", "device_id", "driver_version", "sample_rate_hz", "block_frames", "inputs"],
      "properties": {
        "host_api": {"enum": ["asio", "wasapi", "coreaudio"]},
        "device_class": {"enum": ["dvs", "professional-interface", "ordinary-device", "synthetic"]},
        "device_id": {"type": "string", "minLength": 1},
        "driver_version": {"type": "string", "minLength": 1},
        "sample_rate_hz": {"const": 48000},
        "block_frames": {"type": "integer", "minimum": 16, "maximum": 4096},
        "inputs": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    },
    "mediaProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "sample_rate_hz", "channels", "packetization_ms", "target_bitrate_bps", "dtx", "inband_fec", "requested_jitter_target_ms"],
      "properties": {
        "codec": {"const": "opus"},
        "sample_rate_hz": {"const": 48000},
        "channels": {"enum": [1, 2]},
        "packetization_ms": {"enum": [10, 20]},
        "target_bitrate_bps": {"type": "integer", "minimum": 32000, "maximum": 256000},
        "dtx": {"const": false},
        "inband_fec": {"type": "boolean"},
        "requested_jitter_target_ms": {"type": "integer", "minimum": 0, "maximum": 200}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "device", "os_version", "browser_engine", "browser_product", "browser_version", "execution_profile", "output_route"],
      "properties": {
        "class": {"enum": ["wired", "wifi6"]},
        "device": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "browser_engine": {"enum": ["chromium", "firefox", "webkit"]},
        "browser_product": {"enum": ["chrome", "edge", "firefox", "safari"]},
        "browser_version": {"type": "string", "minLength": 1},
        "execution_profile": {"enum": ["real-device", "playwright"]},
        "output_route": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"type": "object", "properties": {"browser_product": {"const": "chrome"}}, "required": ["browser_product"]}, "then": {"type": "object", "properties": {"browser_engine": {"const": "chromium"}}}},
        {"if": {"type": "object", "properties": {"browser_product": {"const": "edge"}}, "required": ["browser_product"]}, "then": {"type": "object", "properties": {"browser_engine": {"const": "chromium"}}}},
        {"if": {"type": "object", "properties": {"browser_product": {"const": "firefox"}}, "required": ["browser_product"]}, "then": {"type": "object", "properties": {"browser_engine": {"const": "firefox"}}}},
        {"if": {"type": "object", "properties": {"browser_product": {"const": "safari"}}, "required": ["browser_product"]}, "then": {"type": "object", "properties": {"browser_engine": {"const": "webkit"}}}}
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["switch", "access_point", "client_subnet", "media_udp_range", "impairment"],
      "properties": {
        "switch": {"type": "string", "minLength": 1},
        "access_point": {"type": "string", "minLength": 1},
        "client_subnet": {"type": "string", "minLength": 1},
        "media_udp_range": {"type": "string", "pattern": "^[0-9]{1,5}-[0-9]{1,5}$"},
        "impairment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile_id", "direction", "base_delay_us", "delay_distribution", "random_loss_ppm", "loss_model", "burst_loss_max_packets", "burst_transition_ppm", "jitter_p95_us", "jitter_max_us", "jitter_distribution", "reorder_ppm", "duplicate_ppm", "corrupt_ppm", "bandwidth_bps", "queue_bytes", "rf_load_profile", "roam_method", "outages"],
          "properties": {
            "profile_id": {"type": "string", "minLength": 1},
            "direction": {"enum": ["ingress", "egress", "bidirectional"]},
            "base_delay_us": {"type": "integer", "minimum": 0, "maximum": 5000000},
            "delay_distribution": {"enum": ["constant", "normal", "pareto", "trace-replay"]},
            "random_loss_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "loss_model": {"enum": ["random", "gilbert-elliott", "trace-replay"]},
            "burst_loss_max_packets": {"type": "integer", "minimum": 0, "maximum": 1000},
            "burst_transition_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "jitter_p95_us": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "jitter_max_us": {"type": "integer", "minimum": 0, "maximum": 5000000},
            "jitter_distribution": {"enum": ["none", "normal", "pareto", "trace-replay"]},
            "reorder_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "duplicate_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "corrupt_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "bandwidth_bps": {"type": "integer", "minimum": 64000},
            "queue_bytes": {"type": "integer", "minimum": 1024},
            "rf_load_profile": {"type": "string", "minLength": 1},
            "roam_method": {"type": "string", "minLength": 1},
            "outages": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["at_s", "duration_ms", "reason"],
                "properties": {
                  "at_s": {"type": "integer", "minimum": 0},
                  "duration_ms": {"type": "integer", "minimum": 1, "maximum": 300000},
                  "reason": {"type": "string", "minLength": 1, "maxLength": 128}
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_clients", "replay_readers", "ledger_bytes", "replay_bytes", "worker_memory_bytes", "worker_handles", "worker_sockets", "fsync_p99_ms"],
      "properties": {
        "audio_clients": {"type": "integer", "minimum": 1, "maximum": 8},
        "replay_readers": {"type": "integer", "minimum": 0, "maximum": 2},
        "ledger_bytes": {"type": "integer", "minimum": 1048576},
        "replay_bytes": {"type": "integer", "minimum": 1048576},
        "worker_memory_bytes": {"type": "integer", "minimum": 1048576},
        "worker_handles": {"type": "integer", "minimum": 16},
        "worker_sockets": {"type": "integer", "minimum": 4},
        "fsync_p99_ms": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "duration_s", "warmup_s"],
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 100},
        "duration_s": {"type": "integer", "minimum": 60, "maximum": 172800},
        "warmup_s": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_s", "kind", "profile_id", "duration_s"],
      "properties": {
        "at_s": {"type": "integer", "minimum": 0},
        "kind": {"enum": [
          "packet-loss", "jitter", "backend-restart", "roam", "media-worker-crash", "scheduler-stall", "capture-epoch-change",
          "admission-plus-one", "ice-restart-storm", "control-flood", "malformed-contract", "unknown-field", "signed-body-coercion-attempt",
          "storage-worker-crash", "power-cut", "checkpoint-interrupt", "migration-interrupt", "login-logout", "worker-crash", "update-power-cut", "rollback",
          "certificate-expiry", "certificate-revocation", "clock-rollback", "key-rotation", "disk-pressure", "replay-seek-storm", "receiver-reconnect-storm",
          "hostile-image-decode", "backend-partition", "old-node-power-off", "old-node-restart", "lease-replay", "qlab-reconnect", "duplicate-event",
          "late-event", "audition-event", "panic-reset"
        ]},
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "duration_s": {"type": "integer", "minimum": 0, "maximum": 86400}
      }
    }
  }
}

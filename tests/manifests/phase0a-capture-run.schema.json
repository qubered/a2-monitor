{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/phase0a-capture-run.schema.json",
  "title": "Frozen Phase 0A capture run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "test_id", "commit", "implementation", "tuple", "audio", "trials", "faults", "assertion_ids", "artifact_kinds", "integrity_oracle"],
  "properties": {
    "schema_version": {"const": "phase0a-capture-run/v0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "test_id": {"enum": ["capture.64ch.48k.nominal-soak.v1", "capture.device-clock-change.v1", "ipc.abi-confinement.v1"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation": {"$ref": "#/$defs/implementation"},
    "tuple": {"$ref": "#/$defs/tuple"},
    "audio": {"$ref": "#/$defs/audio"},
    "trials": {"$ref": "#/$defs/trials"},
    "faults": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/fault"}},
    "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.]+$"}},
    "artifact_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "integrity_oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "seed", "detect"],
      "properties": {
        "algorithm": {"const": "per-channel-sequence-v0"},
        "seed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "detect": {
          "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
          "items": {"enum": ["permutation", "duplication", "omission", "inserted_frames", "lost_frames", "cross_channel_contamination"]}
        }
      }
    }
  },
  "$defs": {
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["build_id", "rust_version", "audio_host_adapter", "audio_host_adapter_version", "cpal_version", "sqlite_version", "dependency_lock_sha256"],
      "properties": {
        "build_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "rust_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "audio_host_adapter": {"type": "string", "minLength": 1, "maxLength": 64},
        "audio_host_adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "cpal_version": {"type": "string", "minLength": 1, "maxLength": 32},
        "sqlite_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tuple": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "os_version", "cpu", "ram_bytes", "storage", "filesystem", "power_profile"],
      "properties": {
        "os": {"enum": ["windows", "macos"]},
        "os_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "cpu": {"type": "string", "minLength": 1, "maxLength": 128},
        "ram_bytes": {"type": "integer", "minimum": 4294967296},
        "storage": {"type": "string", "minLength": 1, "maxLength": 128},
        "filesystem": {"type": "string", "minLength": 1, "maxLength": 32},
        "power_profile": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["host_api", "device_class", "device", "device_id", "driver", "driver_version", "firmware", "sample_rate_hz", "requested_block_frames", "actual_block_frames", "inputs"],
      "properties": {
        "host_api": {"enum": ["asio", "wasapi", "coreaudio"]},
        "device_class": {"enum": ["dvs", "professional-interface", "ordinary-device", "synthetic-ipc"]},
        "device": {"type": "string", "minLength": 1, "maxLength": 128},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "driver": {"type": "string", "minLength": 1, "maxLength": 128},
        "driver_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "firmware": {"type": "string", "minLength": 1, "maxLength": 64},
        "sample_rate_hz": {"const": 48000},
        "requested_block_frames": {"type": "integer", "minimum": 16, "maximum": 4096},
        "actual_block_frames": {"type": "integer", "minimum": 16, "maximum": 4096},
        "inputs": {"type": "integer", "minimum": 32, "maximum": 64}
      }
    },
    "trials": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "duration_s", "warmup_s"],
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 100},
        "duration_s": {"type": "integer", "minimum": 60, "maximum": 172800},
        "warmup_s": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "fault": {
      "type": "object", "additionalProperties": false,
      "required": ["at_s", "kind", "profile_id", "duration_s"],
      "properties": {
        "at_s": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["device-disconnect", "clock-discontinuity", "consumer-crash", "index-corruption", "header-corruption", "unauthorized-open"]},
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "duration_s": {"type": "integer", "minimum": 0, "maximum": 600}
      }
    }
  }
}

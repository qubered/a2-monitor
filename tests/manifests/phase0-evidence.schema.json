{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/phase0-evidence.schema.json",
  "title": "Frozen Phase 0 evidence-run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "phase", "commit", "builds", "hardware",
    "audio", "clients", "network", "limits", "load", "trials", "faults",
    "integrity_oracle", "assertions", "artifact_policy"
  ],
  "properties": {
    "schema_version": {"const": "phase0-evidence/v0"},
    "manifest_id": {"type": "string", "format": "uuid"},
    "phase": {"enum": ["0A", "0B"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "builds": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "version", "sha256", "signer"],
        "properties": {
          "component": {"type": "string", "maxLength": 64},
          "version": {"type": "string", "maxLength": 64},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "signer": {"type": "string", "maxLength": 128}
        }
      }
    },
    "hardware": {"type": "object", "minProperties": 4, "maxProperties": 64},
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["device", "driver", "firmware", "sample_rate_hz", "block_frames", "inputs"],
      "properties": {
        "device": {"type": "string", "maxLength": 128},
        "driver": {"type": "string", "maxLength": 128},
        "firmware": {"type": "string", "maxLength": 64},
        "sample_rate_hz": {"const": 48000},
        "block_frames": {"type": "integer", "minimum": 16, "maximum": 4096},
        "inputs": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    },
    "clients": {"type": "array", "maxItems": 32, "items": {"type": "object", "minProperties": 4, "maxProperties": 32}},
    "network": {"type": "object", "minProperties": 3, "maxProperties": 64},
    "limits": {"type": "object", "minProperties": 8, "maxProperties": 128},
    "load": {"type": "object", "required": ["seed"], "minProperties": 2, "maxProperties": 64},
    "trials": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "duration_s", "warmup_s"],
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 100},
        "duration_s": {"type": "integer", "minimum": 60, "maximum": 172800},
        "warmup_s": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "faults": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["at_s", "kind", "duration_s"],
        "properties": {
          "at_s": {"type": "integer", "minimum": 0},
          "kind": {"type": "string", "maxLength": 64},
          "duration_s": {"type": "integer", "minimum": 0, "maximum": 86400},
          "parameters": {"type": "object", "maxProperties": 32}
        }
      }
    },
    "integrity_oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "seed", "detect"],
      "properties": {
        "algorithm": {"const": "per-channel-sequence-v0"},
        "seed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "detect": {
          "type": "array", "minItems": 6, "uniqueItems": true,
          "items": {"enum": ["permutation", "duplication", "omission", "inserted_frames", "lost_frames", "cross_channel_contamination"]}
        }
      }
    },
    "assertions": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric", "operator", "threshold", "unit"],
        "properties": {
          "metric": {"type": "string", "maxLength": 96},
          "operator": {"enum": ["eq", "lt", "lte", "gt", "gte"]},
          "threshold": {"type": "number"},
          "unit": {"type": "string", "maxLength": 32}
        }
      }
    },
    "artifact_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["store", "retention_days", "hash", "signature"],
      "properties": {
        "store": {"type": "string", "maxLength": 256},
        "retention_days": {"type": "integer", "minimum": 30, "maximum": 3650},
        "hash": {"const": "sha256"},
        "signature": {"enum": ["ed25519", "ecdsa-p256"]}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/phase1-operator-run.schema.json",
  "title": "Frozen Phase 1 operator qualification run",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "test_id", "commit", "fixture_revision", "operators", "training", "repetitions", "blind_faults", "thresholds", "abort_criteria", "assertion_ids", "artifact_kinds"],
  "properties": {
    "schema_version": {"const": "phase1-operator-run/v0"}, "manifest_id": {"type": "string", "format": "uuid"},
    "test_id": {"enum": ["operator.1a1.identify-monitor.v1", "operator.1a2.intervene-collaborate.v1", "operator.1a3.recover-rehearse.v1", "alerts.1a2.labeled-qualification.v1"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "fixture_revision": {"type": "string", "const": "theatre-reference/v1"},
    "operators": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["participant_id", "role", "experience_band"], "properties": {"participant_id": {"type": "string", "format": "uuid"}, "role": {"enum": ["a1", "a2", "rf", "observer", "show-caller"]}, "experience_band": {"enum": ["novice-qualified", "working", "senior"]}}}},
    "training": {"type": "object", "additionalProperties": false, "required": ["script_revision", "minutes", "competency_check_passed"], "properties": {"script_revision": {"type": "string", "minLength": 1}, "minutes": {"type": "integer", "minimum": 15, "maximum": 480}, "competency_check_passed": {"const": true}}},
    "repetitions": {"type": "integer", "minimum": 5, "maximum": 50},
    "blind_faults": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["wrong-source-decoy", "pack-failure", "partial-swap", "rf-dropout", "battery-critical", "cue-stale", "backend-loss", "node-restart", "operator-absent", "ledger-restore"]}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["detection_p95_ms", "correct_action_p95_ms", "swap_p95_ms", "recovery_p95_ms", "maximum_noncritical_errors", "wrong_source_actions", "unsafe_actions"], "properties": {"detection_p95_ms": {"type": "integer", "minimum": 100, "maximum": 60000}, "correct_action_p95_ms": {"type": "integer", "minimum": 100, "maximum": 120000}, "swap_p95_ms": {"type": "integer", "minimum": 1000, "maximum": 120000}, "recovery_p95_ms": {"type": "integer", "minimum": 1000, "maximum": 900000}, "maximum_noncritical_errors": {"type": "integer", "minimum": 0, "maximum": 20}, "wrong_source_actions": {"const": 0}, "unsafe_actions": {"const": 0}, "missed_critical_alerts": {"const": 0}, "canonical_history_loss": {"const": 0}}},
    "abort_criteria": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["hearing-safety", "programme-path-risk", "wrong-source-action", "loss-of-conventional-comms", "observer-stop"]}},
    "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.]+$"}},
    "artifact_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
  }
}

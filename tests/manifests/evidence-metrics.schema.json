{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.audio.invalid/tests/evidence-metrics.schema.json",
  "title": "Evidence verifier metrics v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assertions"],
  "properties": {
    "schema_version": {"const": "evidence-metrics/v0"},
    "assertions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 160},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observed", "unit"],
        "properties": {
          "observed": {
            "anyOf": [
              {"type": "number"},
              {"type": "boolean"},
              {"type": "string"}
            ]
          },
          "unit": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    }
  }
}

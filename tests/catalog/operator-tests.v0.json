{
  "schema_version": "operator-test-catalog/v0",
  "reference_fixture": {"id": "theatre-reference/v1", "performers": 32, "roles": 40, "captured_paths": 48, "receiver_paths": 48, "prepared_spares": 6, "zones": 8, "cue_definitions_minimum": 120},
  "tests": {
    "operator.1a1.identify-monitor.v1": {
      "slice": "1A.1", "minimum_repetitions": 5,
      "required_faults": ["wrong-source-decoy", "pack-failure", "backend-loss", "battery-critical", "rf-dropout"],
      "assertions": {
        "operator.wrong_source_actions.zero": {"operator": "eq", "expected": 0, "unit": "count"},
        "operator.unsafe_actions.zero": {"operator": "eq", "expected": 0, "unit": "count"},
        "identity.historical_corruption.zero": {"operator": "eq", "expected": 0, "unit": "count"},
        "operator.timing_thresholds.all": {"operator": "eq", "expected": true, "unit": "boolean"}
      },
      "zero_tolerance": ["wrong_source_actions", "unsafe_actions"],
      "required_artifacts": ["verifier-metrics", "observer-log", "screen-recording", "canonical-ledger", "timing-export", "operator-debrief"]
    },
    "operator.1a2.intervene-collaborate.v1": {
      "slice": "1A.2", "minimum_repetitions": 5,
      "required_faults": ["partial-swap", "rf-dropout", "cue-stale", "operator-absent", "battery-critical"],
      "assertions": {
        "operator.wrong_source_actions.zero": {"operator": "eq", "expected": 0, "unit": "count"},
        "operator.unsafe_actions.zero": {"operator": "eq", "expected": 0, "unit": "count"},
        "swap.physical_truth_preserved.all": {"operator": "eq", "expected": true, "unit": "boolean"},
        "handoff.coverage_preserved.all": {"operator": "eq", "expected": true, "unit": "boolean"}
      },
      "zero_tolerance": ["wrong_source_actions", "unsafe_actions"],
      "required_artifacts": ["verifier-metrics", "observer-log", "screen-recording", "canonical-ledger", "physical-boundary-log", "intercom-log"]
    },
    "alerts.1a2.labeled-qualification.v1": {
      "slice": "1A.2", "minimum_repetitions": 5,
      "required_faults": ["rf-dropout", "battery-critical", "cue-stale", "wrong-source-decoy", "pack-failure"],
      "assertions": {
        "alert.missed_critical.zero": {"operator": "eq", "expected": 0, "unit": "count"},
        "alert.flood_threshold.pass": {"operator": "eq", "expected": true, "unit": "boolean"},
        "alert.correct_action_timing.pass": {"operator": "eq", "expected": true, "unit": "boolean"},
        "operator.unsafe_actions.zero": {"operator": "eq", "expected": 0, "unit": "count"}
      },
      "zero_tolerance": ["missed_critical_alerts", "unsafe_actions"],
      "required_artifacts": ["verifier-metrics", "labeled-ground-truth", "alert-export", "observer-log", "timing-export"]
    },
    "operator.1a3.recover-rehearse.v1": {
      "slice": "1A.3", "minimum_repetitions": 5,
      "required_faults": ["node-restart", "ledger-restore", "backend-loss", "partial-swap", "operator-absent"],
      "assertions": {
        "operator.wrong_source_actions.zero": {"operator": "eq", "expected": 0, "unit": "count"},
        "operator.unsafe_actions.zero": {"operator": "eq", "expected": 0, "unit": "count"},
        "ledger.canonical_history_loss.zero": {"operator": "eq", "expected": 0, "unit": "events"},
        "recovery.timing_thresholds.all": {"operator": "eq", "expected": true, "unit": "boolean"}
      },
      "zero_tolerance": ["wrong_source_actions", "unsafe_actions", "canonical_history_loss"],
      "required_artifacts": ["verifier-metrics", "observer-log", "recovery-ledger", "projection-diff", "backup-restore-log", "signed-run-result"]
    }
  }
}
